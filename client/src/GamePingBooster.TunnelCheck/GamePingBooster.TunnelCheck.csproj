<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- A developer tool, never shipped, like PathCheck: no packages, not AOT-published. -->
    <IsAotCompatible>false</IsAotCompatible>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamePingBooster.Core\GamePingBooster.Core.csproj" />
    <ProjectReference Include="..\GamePingBooster.Service\GamePingBooster.Service.csproj" />
  </ItemGroup>

</Project>
