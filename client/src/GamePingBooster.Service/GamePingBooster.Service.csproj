<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>gpb-service</AssemblyName>
    <RootNamespace>GamePingBooster.Service</RootNamespace>

    <!-- Native AOT: the exe is real machine code, so users do not need the .NET Runtime. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>true</StackTraceSupport>

    <!-- P/Invoke stubs generated at compile time instead of runtime marshalling (required for AOT). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamePingBooster.Core\GamePingBooster.Core.csproj" />
  </ItemGroup>

  <!-- wintun.dll must sit next to the exe. Download the officially signed build from wintun.net. -->
  <ItemGroup>
    <None Include="..\..\native\wintun\wintun.dll" Condition="Exists('..\..\native\wintun\wintun.dll')" CopyToOutputDirectory="PreserveNewest" Link="wintun.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <!-- DPAPI. ProtectedData is NOT in the base framework for net9.0-windows - checked by
         compiling against it, not assumed - so it comes from here. This is Microsoft's own thin
         shim over CryptProtectData, and it is the alternative to hand-rolling crypt32 interop
         with DATA_BLOB marshalling and LocalFree, which is where a subtle leak would live.
         Verified Native AOT publishes and runs with it before it was added. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
