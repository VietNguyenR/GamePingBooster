<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- A developer tool, never shipped: it is not AOT-published and pulls in no packages, so it
         cannot drag a dependency into the client. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamePingBooster.Core\GamePingBooster.Core.csproj" />
  </ItemGroup>

</Project>
