<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>gpb-blockcheck</AssemblyName>
    <RootNamespace>GamePingBooster.BlockCheck</RootNamespace>

    <!-- A developer tool, never shipped: not AOT-published and pulls in no packages, so it cannot
         drag a dependency into the client. Same footing as ProtocolCheck and EtwWatch. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <!-- The DNS wire format lives in Core, shared with the service's resolver: one implementation,
       so a bug found by a measurement is fixed in the thing players run. -->
  <ItemGroup>
    <ProjectReference Include="..\GamePingBooster.Core\GamePingBooster.Core.csproj" />
  </ItemGroup>

</Project>
