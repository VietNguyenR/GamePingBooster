<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GamePingBooster</AssemblyName>
    <RootNamespace>GamePingBooster.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native AOT: no .NET Runtime needed on the user machine, and the app starts almost instantly. -->
    <PublishAot>false</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Required for AOT: bindings must be compiled, not resolved by reflection at runtime.
         Every Window/UserControl must declare x:DataType or the build fails. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TrimMode>full</TrimMode>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <PackageIcon>512x512.png</PackageIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- AvaloniaResource, not Content: the tray icon and the window icon are loaded through
         avares:// at runtime, so the file has to be compiled into the binary rather than sitting
         next to it. ApplicationIcon above is separate - that one is the icon Explorer draws on
         the .exe and is baked in by the linker. -->
    <AvaloniaResource Include="favicon.ico" />
    <AvaloniaResource Include="Resources\Languages\*.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\512x512.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamePingBooster.Core\GamePingBooster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- DPAPI, for the refresh token. Not in the base framework for net9.0-windows - the same
         finding as in the service, checked the same way. Here the scope is CURRENT USER, not
         machine: the refresh token belongs to the person, not to the PC. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
