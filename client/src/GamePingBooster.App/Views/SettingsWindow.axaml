<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        x:Class="GamePingBooster.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Relay settings"
        Width="440" SizeToContent="Height"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F172A">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24" Spacing="16">

    <StackPanel Spacing="4">
      <TextBlock Text="Relay settings" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
      <TextBlock Classes="hint"
                 Text="The addresses of your relays and the key they were installed with. Both are printed by the relay's installer when you set up a server." />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="label" Text="Relay addresses" />
      <TextBox Text="{Binding Endpoints}"
               AcceptsReturn="True" TextWrapping="NoWrap"
               MinHeight="88" MaxHeight="140"
               VerticalContentAlignment="Top"
               PlaceholderText="203.0.113.10:51820" />
      <TextBlock Classes="hint"
                 Text="One per line. With more than one, the app measures them all and uses the fastest, and falls back to the others if that one stops answering." />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="label" Text="Pre-shared key" />
      <TextBox Text="{Binding Psk}" PasswordChar="*" PlaceholderText="{Binding PskWatermark}" />
      <TextBlock Classes="hint" Text="{Binding PskHint}" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="label" Text="Licence server (optional)" />
      <TextBox Text="{Binding LicenceUrl}" PlaceholderText="https://licence.example.com" />
      <TextBlock Classes="hint"
                 Text="Only if you have an account. Leave blank to run entirely on your own relays with the key above - that is the normal setup. Filling this in adds an Account button, and the game list comes from there too." />
    </StackPanel>

    <Border Background="#7F1D1D" CornerRadius="8" Padding="12"
            IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding Error}" Foreground="#FEE2E2" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <Border Background="#14532D" CornerRadius="8" Padding="12"
            IsVisible="{Binding Saved}">
      <TextBlock Text="Saved. Press Connect in the main window."
                 Foreground="#DCFCE7" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <Button Grid.Column="1" Content="Cancel" Click="OnCancelClick"
              Height="38" Width="92" Margin="0,0,8,0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Background="#334155" Foreground="#E2E8F0" CornerRadius="8" />
      <Button Grid.Column="2" Content="Save" Click="OnSaveClick"
              IsEnabled="{Binding CanSave}"
              Height="38" Width="92"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Background="#2563EB" Foreground="White" CornerRadius="8" />
    </Grid>
  </StackPanel>
</Window>
