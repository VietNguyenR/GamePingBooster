<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        xmlns:views="using:GamePingBooster.App.Views"
        xmlns:ck="using:GamePingBooster.App.ViewModels.Checklist"
        x:Class="GamePingBooster.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Game Ping Booster"
        Icon="/favicon.ico"
        Width="420" Height="620"
        MinWidth="380" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- The Game value, clickable. Looks like the other values until there is something to open. -->
    <Style Selector="Button.valuelink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.valuelink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.valuelink:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#242424" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B91C1C" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="MenuFlyoutPresenter.custom-bg">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="BorderBrush" Value="#242424" />
    </Style>
    <!-- The update line under the licence line: small, but the one blue thing at the bottom. -->
    <Style Selector="Button.update">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.update:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.update:pointerover TextBlock">
      <Setter Property="Foreground" Value="#93C5FD" />
    </Style>

    <!-- Kiểm tra máy -->
    <Style Selector="Border.checkcard">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <!-- Shaped like the caption buttons (46 x 30, square corners) so it reads as one of them. -->
    <Style Selector="Button.chevron">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.chevron:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#242424" />
    </Style>
    <Style Selector="Button.strip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.strip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a1a1a" />
    </Style>
    <Style Selector="Button.checkfix">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.checklink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="#60A5FA" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.checklink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#93C5FD" />
    </Style>
    <Style Selector="Button.checklink:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4b4b4b" />
    </Style>
  </views:SurfaceWindow.Styles>

  <!--
    Two columns: the window as it always was on the left, unchanged, and the "Kiểm tra máy" panel on the right
    (pc-checklist-handoff.md). The panel's width is added to the window's in code-behind (ApplyPanelWidth), so the
    left part keeps its size whether the panel is open, collapsed to its strip, or neither.
  -->
  <Grid ColumnDefinitions="*,Auto">

  <Grid Grid.Column="0" RowDefinitions="Auto,*">

    <!--
      A spacer, not a title bar - see SurfaceWindow for why there is no title bar to draw.
      It keeps the content clear of the caption buttons and gives somewhere to drag.
    -->
    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

  <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,4,24,24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <!--
        Everything that is not Connect lives here. There were three buttons competing with the
        one that matters; now there is one primary action and a menu.
      -->
      <Button Grid.Column="1" VerticalAlignment="Top"
              Padding="10"
              Background="Transparent" BorderThickness="0"
              ToolTip.Tip="{DynamicResource main.menu.tip}">
        <Button.Content>
          <Path Data="M0,0 H14 M0,5 H14 M0,10 H14" Stroke="#ababab" StrokeThickness="1.6" />
        </Button.Content>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="custom-bg">
            <MenuItem Header="{Binding AccountMenuText}" Click="OnAccountClick"
                      IsVisible="{Binding ShowLicence}" />
            <MenuItem Header="{DynamicResource main.menu.settings}" Click="OnSettingsClick" />
            <MenuItem Header="{DynamicResource main.menu.games}" Click="OnGamesClick" />
            <Separator Background="#242424" />
            <MenuItem Header="{DynamicResource main.menu.reportLag}" Click="OnReportLagClick" />
            <MenuItem Header="{DynamicResource main.menu.logs}" Click="OnLogsClick" />
            <MenuItem Header="{DynamicResource main.menu.about}" Click="OnAboutClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Primary status -->
    <Border Grid.Row="1" Classes="card" Margin="0,20,0,0">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                   Fill="{Binding StatusBrush}" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{Binding StatusBrush}"
                     FontSize="22" FontWeight="Bold" />
        </StackPanel>

        <TextBlock Text="{Binding Detail}"
                   Foreground="#ababab" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="320" />

        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                     IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <!-- Details -->
    <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
      <Border Classes="card">
        <!-- Ping in game first, ping to the relay under it. The order is the point: the relay
             figure is the one a tester read as his game ping, saw 23 ms, and then played at
             70-80 - it is half the path and it must not sit at the top wearing that meaning. -->
        <!-- Values take the width that is left and are cut with an ellipsis, the full text in a
             tooltip: a relay or game name, or a message, must never push the card wider than
             the window. Labels are short and fixed, so they keep their natural width. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" >
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.gamePing}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding GamePingText}" ToolTip.Tip="{Binding GamePingTip}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.relayPing}" Margin="0,10,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding PingText}" Margin="0,10,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.loss}" Margin="0,10,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding LossText}" Margin="0,10,0,0" ToolTip.Tip="{Binding LossTip}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.relay}" Margin="0,10,0,0" />
          <!-- Green is where the game's traffic is: home here, or one name on the Adaptive Tunnel line below while a
               match plays through it. -->
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding RelayText}" Margin="0,10,0,0" ToolTip.Tip="{Binding RelayTip}"
                     Foreground="{Binding RelayBrush}" />

          <!-- The region plan's other relays for this game - a dash while it has none, the line always there so the card
               does not change height mid-session. At most three (four tunnels, home
               included); three long names can run past the card and are clipped (ClipToBounds), the tooltip lists every
               region. Each one is its own TextBlock so the carrier alone turns green. -->
          <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.adaptive}" Margin="0,10,0,0"
/>
          <ItemsControl Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Right" ClipToBounds="True"
                        ItemsSource="{Binding AdaptiveTunnels}"
                        ToolTip.Tip="{Binding AdaptiveTip}" Background="Transparent">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdaptiveTunnel">
                <TextBlock Classes="value" Text="{Binding Text}" Foreground="{Binding Foreground}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.game}" Margin="0,10,0,0" />
          <!-- A link to the list of supported games once there is one: the line itself only says how
               many, so that it stays one line however many games are added. -->
          <Button Grid.Row="5" Grid.Column="1" Classes="valuelink" Margin="0,10,0,0"
                  Click="OnGamesClick" IsEnabled="{Binding HasGames}" ToolTip.Tip="{DynamicResource main.games.tip}">
            <TextBlock Classes="value" Text="{Binding GameText}" Foreground="{Binding GameTextBrush}" />
          </Button>

          <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.routing}" Margin="0,10,0,0" />
          <TextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding RouteText}" Margin="0,10,0,0" ToolTip.Tip="{Binding RouteText}" />

          <!-- Unblocking sits under Routing and above Packets on purpose: it belongs with what the
               product DID, not with the counters. It is the one line here that is not about speed -
               it says a blocked site is reachable again - so the tooltip has to carry the part that
               surprises people, which is that downloads are deliberately left alone because the
               provider's own path is the faster one for those.

               It names the services rather than saying "on", because which ones are unblocked comes
               from the server now and this window is the only place that knows. -->
          <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.unblock}" Margin="0,10,0,0" />
          <TextBlock Grid.Row="7" Grid.Column="1" Classes="value" Text="{Binding UnblockText}" Margin="0,10,0,0" ToolTip.Tip="{Binding UnblockTip}" />

          <TextBlock Grid.Row="8" Grid.Column="0" Classes="label" Text="{DynamicResource main.label.packets}" Margin="0,10,0,0" />
          <TextBlock Grid.Row="8" Grid.Column="1" Classes="value" Text="{Binding PacketsText}" Margin="0,10,0,0" />
        </Grid>
      </Border>

      <!-- Unblocking could not turn on for a reason only the player can fix (Windows set to Require DoH, or
           something else owning DNS): what is wrong and how to fix it. Amber, not red - the tunnel still works. -->
      <Border Background="#422006" CornerRadius="8" Padding="12"
              IsVisible="{Binding HasUnblockProblem}">
        <SelectableTextBlock Text="{Binding UnblockProblem}" Foreground="#FDE68A"
                             FontSize="12" TextWrapping="Wrap" />
      </Border>

      <!-- Error banner, only shown when something went wrong -->
      <Border Background="#7F1D1D" CornerRadius="8" Padding="12"
              IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding Error}" Foreground="#FEE2E2"
                   FontSize="12" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Primary action -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

      <!-- First run: there is no relay yet, so say so instead of offering a button that
           could only fail. -->
      <Border Grid.Row="0" Grid.ColumnSpan="2"
              Background="#20252b" CornerRadius="8" Padding="12" Margin="0,0,0,12"
              IsVisible="{Binding ShowSetupBanner}">
        <TextBlock Foreground="#869bb3" FontSize="12" TextWrapping="Wrap"
                   Text="{Binding SetupText}" />
      </Border>

      <!-- Which relay to use: automatic, or one the player picks. The same list for every game. -->
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12" Spacing="4"
                  IsVisible="{Binding ShowRelayChoice}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Grid.Column="0" Text="{DynamicResource main.server.label}" Foreground="#ababab" FontSize="13"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding RelayItems}"
                    SelectedItem="{Binding SelectedRelay}"
                    IsEnabled="{Binding CanChooseRelay}"
                    DropDownOpened="OnRelayListOpened"
                    DropDownClosed="OnRelayListClosed"
                    Background="#242424" Foreground="#E2E8F0" BorderThickness="0" CornerRadius="8"
                    ToolTip.Tip="{DynamicResource main.server.tip}">
            <ComboBox.Styles>
              <!-- A relay the operator has taken off the game in play stays in the list, greyed out. -->
              <Style Selector="ComboBoxItem" x:DataType="vm:RelayChoiceItem">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
              </Style>
            </ComboBox.Styles>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RelayChoiceItem">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <TextBlock Text="{Binding RelayChoiceNote}" IsVisible="{Binding HasRelayChoiceNote}"
                   Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right" />
      </StackPanel>

      <Button Grid.Row="2" Grid.ColumnSpan="2"
              Content="{Binding ActionButtonText}"
              IsEnabled="{Binding CanPressAction}"
              Click="OnActionClick"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Height="46" FontSize="15" FontWeight="SemiBold"
              Background="#2563EB" Foreground="White"
              CornerRadius="10" />

      <!-- Under the button while it starts boosting: there is no game to pick, and a player looking for where
           to choose one reads here that there is nothing to choose. Gone once connected, where the status line
           says it is waiting for a game. -->
      <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                 IsVisible="{Binding ShowStartHint}"
                 Text="{DynamicResource action.connect.hint}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="#787878" FontSize="11"
                 Margin="0,6,0,0" />

      <!-- Only on an installation that has a licence server. A self-hosted one never sees any
           of this, which is the default and stays the default. -->
      <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                 IsVisible="{Binding ShowLicenceLine}"
                 Text="{Binding LicenceText}"
                 TextWrapping="Wrap"
                 Foreground="{Binding LicenceBrush}" FontSize="11"
                 Margin="0,10,0,0" />

      <!-- Only there when there is something to say about updates. Since 0.5.0 the service installs them by
           itself and this line only says so; "Update →" (UpdateWindow, UAC) shows only when it cannot. A click
           still opens the window either way - the manual way in for a release the service is waiting on. -->
      <Button Grid.Row="5" Grid.ColumnSpan="2" Classes="update" Margin="0,10,0,0"
              Click="OnUpdateClick" IsVisible="{Binding HasUpdate}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding UpdateFooterText}" Foreground="#ababab" FontSize="11" />
          <TextBlock Text="{DynamicResource main.update.action}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"
                     IsVisible="{Binding ShowUpdateAction}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
  </Grid>

  <!-- ===================================================== Kiểm tra máy -->

  <!-- Open. Header and footer stay put; only the list scrolls. The top 38 px is a drag area, level with the main part's
       caption row - the buttons themselves stay over the main part (PlaceCaptionButtons). -->
  <Border Grid.Column="1" Width="{x:Static views:MainWindow.PanelWidth}"
          IsVisible="{Binding Checklist.IsOpen}"
          BorderBrush="#242424" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="38,Auto,*,Auto">
      <!-- The collapse button sits in the caption row, the size of a caption button and level with close - the panel's
           own "window control". Role User, or the title bar under it takes the click as a drag. The arrow points the way the panel goes: inwards, to fold it away. -->
      <!-- The title shares that row, centred on the 30 px of the caption buttons. Not hit-testable, so the row still
           drags the window. -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" PointerPressed="OnTitleBarPressed" />
        <TextBlock Grid.Column="0" Height="30" VerticalAlignment="Top" Margin="16,0,8,0" Padding="0,7,0,0"
                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                   Text="{DynamicResource check.panel.title}" Foreground="#e5e5e5" FontSize="13" FontWeight="SemiBold" />
        <Button Grid.Column="1" Classes="chevron" Width="46" Click="OnChecklistToggle"
                WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="{DynamicResource check.panel.collapse}">
          <Path Data="M5,1 L1,5 L5,9" Stroke="#ababab" StrokeThickness="1.4" />
        </Button>
      </Grid>

      <TextBlock Grid.Row="1" Margin="16,0,16,12"
                 Text="{Binding Checklist.HeaderText}" IsVisible="{Binding Checklist.HasHeaderText}"
                 Foreground="{Binding Checklist.HeaderBrush}" FontSize="12" />

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,0,16,12" Spacing="8">

          <ItemsControl ItemsSource="{Binding Checklist.Attention}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ck:CheckItem">
                <Border Classes="checkcard">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Path Grid.Column="0" Data="{Binding SeverityIcon}" Stroke="{Binding SeverityBrush}"
                          StrokeThickness="1.6" Width="16" Height="16" Stretch="None" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" Foreground="#e5e5e5" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Summary}" Foreground="#ababab" FontSize="12" TextWrapping="Wrap" />
                      <SelectableTextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}"
                                           Foreground="#787878" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0"
                                  IsVisible="{Binding HasActions}">
                        <Button Classes="checkfix" Content="{Binding FixLabel}" IsVisible="{Binding HasFix}"
                                Click="OnCheckFix" />
                        <Button Classes="checklink" Content="{DynamicResource check.restore}" IsVisible="{Binding CanRestore}"
                                Click="OnCheckRestore" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The good ones, folded. Closed by default: a line that is fine has nothing to say twice. -->
          <StackPanel Spacing="6" IsVisible="{Binding Checklist.HasGood}">
            <Button Classes="checklink" Click="OnChecklistGoodToggle" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{Binding Checklist.GoodChevron}" Stroke="#ababab" StrokeThickness="1.4"
                      Width="10" Height="10" Stretch="None" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Checklist.GoodHeader}" Foreground="#ababab" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Checklist.Good}" IsVisible="{Binding Checklist.IsGoodExpanded}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="ck:CheckItem">
                  <Border Classes="checkcard" Padding="12,8">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                      <Path Grid.Column="0" Data="{Binding SeverityIcon}" Stroke="{Binding SeverityBrush}"
                            StrokeThickness="1.6" Width="16" Height="16" Stretch="None" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#e5e5e5" FontSize="12" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="#ababab" FontSize="12"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Summary}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="#242424" BorderThickness="0,1,0,0" Padding="16,10">
        <Button Classes="checklink" HorizontalAlignment="Center"
                Content="{DynamicResource check.restoreAll}"
                IsEnabled="{Binding Checklist.CanRestoreAll}" Click="OnChecklistRestoreAll" />
      </Border>
    </Grid>
  </Border>

  <!-- Collapsed: a strip on the right edge with the way back, a count, and one icon per problem. Its chevron lines up
       with the open panel's. The caption buttons sit over the main part, not here (PlaceCaptionButtons). -->
  <Border Grid.Column="1" Width="{x:Static views:MainWindow.StripWidth}"
          IsVisible="{Binding Checklist.IsCollapsed}"
          BorderBrush="#242424" BorderThickness="1,0,0,0">
    <Button Classes="strip" Click="OnChecklistToggle" WindowDecorationProperties.ElementRole="User" ToolTip.Tip="{DynamicResource check.panel.expand}">
      <!-- The arrow points outwards - "open" - and is centred on the caption row (30 px), level with close. -->
      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Path Data="M1,1 L5,5 L1,9" Stroke="#ababab" StrokeThickness="1.4" HorizontalAlignment="Center" />
        <Border Margin="0,18,0,0" Background="#fbbf24" CornerRadius="8" MinWidth="16" Height="16" Padding="3,0"
                HorizontalAlignment="Center" IsVisible="{Binding Checklist.HasProblems}">
          <TextBlock Text="{Binding Checklist.BadgeText}" Foreground="#111111" FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ItemsControl ItemsSource="{Binding Checklist.Problems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ck:CheckItem">
              <Path Data="{Binding Icon}" Stroke="{Binding SeverityBrush}" StrokeThickness="1.4"
                    Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"
                    ToolTip.Tip="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Button>
  </Border>

  </Grid>
</views:SurfaceWindow>
