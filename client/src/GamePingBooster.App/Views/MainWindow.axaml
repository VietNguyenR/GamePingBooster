<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        x:Class="GamePingBooster.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Game Ping Booster"
        Width="420" Height="560"
        MinWidth="380" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B91C1C" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!--
      A spacer, not a title bar.

      ExtendClientAreaToDecorationsHint makes the client area reach under the system caption, so
      the window is one continuous surface in our own colour instead of an app sitting below a
      grey Windows bar. Avalonia 12 still draws the title and the caption buttons on top of it,
      which is what we want - drawing our own as well produced two titles in the same place and
      seven caption buttons, which is what the first attempt at this looked like.
      (ExtendClientAreaChromeHints, the Avalonia 11 way of suppressing them, no longer exists.)

      All this row does is keep the content clear of the buttons, and give somewhere to drag.
    -->
    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

  <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="24,4,24,24">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Game Ping Booster"
                   Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="PUBG - Southeast Asia servers"
                   Foreground="#64748B" FontSize="12" />
      </StackPanel>

      <!--
        Everything that is not Connect lives here. There were three buttons competing with the
        one that matters; now there is one primary action and a menu.
      -->
      <Button Grid.Column="1" VerticalAlignment="Top"
              Width="36" Height="36" Padding="0"
              Background="Transparent" BorderThickness="0"
              ToolTip.Tip="Menu">
        <Button.Content>
          <Path Data="M0,0 H14 M0,5 H14 M0,10 H14" Stroke="#94A3B8" StrokeThickness="1.6" />
        </Button.Content>
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{Binding AccountMenuText}" Click="OnAccountClick"
                      IsVisible="{Binding ShowLicence}" />
            <MenuItem Header="Settings" Click="OnSettingsClick" />
            <Separator />
            <MenuItem Header="Open logs folder" Click="OnLogsClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Primary status -->
    <Border Grid.Row="1" Classes="card" Margin="0,20,0,0">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                   Fill="{Binding StatusBrush}" />
          <TextBlock Text="{Binding StatusText}"
                     Foreground="{Binding StatusBrush}"
                     FontSize="22" FontWeight="Bold" />
        </StackPanel>

        <TextBlock Text="{Binding Detail}"
                   Foreground="#94A3B8" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center"
                   MaxWidth="320" />

        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                     IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <!-- Details -->
    <StackPanel Grid.Row="2" Spacing="12" Margin="0,16,0,0">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" >
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Ping to relay" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding PingText}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Packet loss" Margin="0,10,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding LossText}" Margin="0,10,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Relay server" Margin="0,10,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding RelayText}" Margin="0,10,0,0" />

          <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Game" Margin="0,10,0,0" />
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding GameText}" Margin="0,10,0,0" />

          <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Routing" Margin="0,10,0,0" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding RouteText}" Margin="0,10,0,0" />

          <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Packets" Margin="0,10,0,0" />
          <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding PacketsText}" Margin="0,10,0,0" />
        </Grid>
      </Border>

      <!-- Error banner, only shown when something went wrong -->
      <Border Background="#7F1D1D" CornerRadius="8" Padding="12"
              IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding Error}" Foreground="#FEE2E2"
                   FontSize="12" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Primary action -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

      <!-- First run: there is no relay yet, so say so instead of offering a button that
           could only fail. -->
      <Border Grid.Row="0" Grid.ColumnSpan="2"
              Background="#1E3A5F" CornerRadius="8" Padding="12" Margin="0,0,0,12"
              IsVisible="{Binding NeedsSetup}">
        <TextBlock Foreground="#BFDBFE" FontSize="12" TextWrapping="Wrap"
                   Text="No relay configured yet. Open Settings and enter your relay's address and key." />
      </Border>

      <Button Grid.Row="1" Grid.ColumnSpan="2"
              Content="{Binding ActionButtonText}"
              IsEnabled="{Binding CanPressAction}"
              Click="OnActionClick"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Height="46" FontSize="15" FontWeight="SemiBold"
              Background="#2563EB" Foreground="White"
              CornerRadius="10" />

      <!-- Only on an installation that has a licence server. A self-hosted one never sees any
           of this, which is the default and stays the default. -->
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                 IsVisible="{Binding ShowLicence}"
                 Text="{Binding LicenceText}"
                 TextWrapping="Wrap"
                 Foreground="{Binding LicenceBrush}" FontSize="11"
                 Margin="0,10,0,0" />


    </Grid>
  </Grid>
  </Grid>
</Window>
