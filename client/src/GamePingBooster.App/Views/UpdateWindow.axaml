<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GamePingBooster.App.Views"
        x:Class="GamePingBooster.App.Views.UpdateWindow"
        Title="{DynamicResource update.window.title}"
        Width="420" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </views:SurfaceWindow.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

    <StackPanel Grid.Row="1" Margin="24,4,24,24" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Name="TitleText" Text="Update" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
        <TextBlock Name="SubtitleText" Classes="label" />
      </StackPanel>

      <!-- ============================================================ confirm -->
      <StackPanel Name="ConfirmPanel" Spacing="14">

        <TextBlock Classes="body" Text="{DynamicResource update.body}" />

        <!-- Only when there is something to lose: a live connection, or a game that may be mid-match. -->
        <Border Name="WarningBox" Background="#422006" CornerRadius="8" Padding="12" IsVisible="False">
          <TextBlock Name="WarningText" Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{DynamicResource update.later}" Click="OnCloseClick"
                  Background="#334155" Foreground="#E2E8F0" />
          <Button Name="UpdateButton" Content="{DynamicResource update.now}" Click="OnUpdateClick"
                  Background="#2563EB" Foreground="White" />
        </StackPanel>
      </StackPanel>

      <!-- ============================================================ downloading -->
      <StackPanel Name="DownloadPanel" Spacing="10" IsVisible="False">
        <TextBlock Classes="body" Text="{DynamicResource update.downloading}" />
        <ProgressBar Name="DownloadBar" Minimum="0" Maximum="1" Height="6" />
        <TextBlock Name="DownloadText" Classes="label" HorizontalAlignment="Right" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{DynamicResource update.cancel}" Click="OnCancelClick"
                  Background="#334155" Foreground="#E2E8F0" />
        </StackPanel>
      </StackPanel>

      <!-- ============================================================ installing -->
      <StackPanel Name="InstallPanel" Spacing="10" IsVisible="False">
        <TextBlock Name="InstallText" Classes="body" />
        <ProgressBar IsIndeterminate="True" Height="6" />
      </StackPanel>

      <!-- ============================================================ failed -->
      <StackPanel Name="FailedPanel" Spacing="14" IsVisible="False">
        <Border Background="#7F1D1D" CornerRadius="8" Padding="12">
          <TextBlock Name="FailedText" Foreground="#FEE2E2" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{DynamicResource update.releasePage}" Click="OnReleasePageClick"
                  Background="#334155" Foreground="#E2E8F0" />
          <Button Content="{DynamicResource update.close}" Click="OnCloseClick"
                  Background="#2563EB" Foreground="White" />
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </Grid>
</views:SurfaceWindow>
