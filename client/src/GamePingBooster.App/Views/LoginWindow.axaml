<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        xmlns:views="using:GamePingBooster.App.Views"
        x:Class="GamePingBooster.App.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sign in"
        Width="400" SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#787878" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#242424" />
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </views:SurfaceWindow.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <!--
      A spacer, not a title bar - see SurfaceWindow for why there is no title bar to draw.
      It keeps the content clear of the caption buttons and gives somewhere to drag.
    -->
    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

  <StackPanel Grid.Row="1" Margin="24,4,24,24" Spacing="14">
    <TextBlock Classes="hint" Text="{Binding ServerText}" />

    <StackPanel Spacing="0">
      <TextBlock Classes="label" Text="Email" />
      <TextBox Text="{Binding Email}" PlaceholderText="you@example.com" />
    </StackPanel>

    <StackPanel Spacing="0">
      <TextBlock Classes="label" Text="Password" />
      <TextBox Text="{Binding Password}" PasswordChar="*" />
    </StackPanel>

    <!-- Which machine this is. "This account already has 2 devices" is unanswerable without it,
         and a public key costs nothing to show. -->
    <TextBlock Classes="hint" Text="{Binding DeviceText}" />

    <Border Background="#7F1D1D" CornerRadius="8" Padding="12,8"
            IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding Error}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick"
              Background="#111111" Foreground="#ababab" />
      <Button Content="{Binding ButtonText}" Click="OnSubmitClick"
              IsEnabled="{Binding CanSubmit}"
              Background="#2563EB" Foreground="White" />
    </StackPanel>

  </StackPanel>
  </Grid>
</views:SurfaceWindow>
