<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        xmlns:views="using:GamePingBooster.App.Views"
        x:Class="GamePingBooster.App.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Sign in"
        Width="400" SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#787878" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </views:SurfaceWindow.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <!--
      A spacer, not a title bar - see SurfaceWindow for why there is no title bar to draw.
      It keeps the content clear of the caption buttons and gives somewhere to drag.
    -->
    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

  <StackPanel Grid.Row="1" Margin="24,4,24,24" Spacing="14">
    <TextBlock Classes="hint" Text="{Binding ServerText}" />

    <!-- Sign-in happens in the browser, and there is no password box here on purpose: this app
         installs a network driver and asks for administrator rights, and it should not also be
         the thing you hand a password to. The device-limit refusal lands on a page that can
         explain it rather than in a dialog after somebody has already typed one.

         The email/password form that used to sit here came out on 2026-09-06, once the browser
         flow was confirmed working on a real machine. The endpoint behind it was deleted on
         2026-09-10, so restoring the form now means restoring the endpoint too - a protocol
         change rather than a UI one. -->
    <Button Content="Sign in with your browser" Click="OnBrowserClick"
            IsEnabled="{Binding !Busy}" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Background="#2563EB" Foreground="White" />

    <TextBlock Classes="hint" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
               TextWrapping="Wrap" />

    <!-- Which machine this is. "This account already has 2 devices" is unanswerable without it,
         and a public key costs nothing to show. -->
    <TextBlock Classes="hint" Text="{Binding DeviceText}" />

    <Border Background="#7F1D1D" CornerRadius="8" Padding="12,8"
            IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding Error}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick"
              Background="#111111" Foreground="#ababab" />
    </StackPanel>

  </StackPanel>
  </Grid>
</views:SurfaceWindow>
