<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GamePingBooster.App.Views"
        x:Class="GamePingBooster.App.Views.ReportLagWindow"
        Title="{DynamicResource lag.title}"
        Width="520" SizeToContent="Height"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.item">
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </views:SurfaceWindow.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

    <StackPanel Grid.Row="1" Margin="24,4,24,24" Spacing="16">

      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource lag.title}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
        <TextBlock Classes="label"
                   Text="{DynamicResource lag.subtitle}" />
      </StackPanel>

      <!-- ============================================================ consent -->
      <StackPanel Name="ConsentPanel" Spacing="14">

        <TextBlock Classes="body"
                   Text="{DynamicResource lag.intro}" />

        <Border Background="#1E293B" CornerRadius="8" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource lag.sent.header}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.sent.1}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.sent.2}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.sent.3}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.sent.4}" />
          </StackPanel>
        </Border>

        <Border Background="#1E293B" CornerRadius="8" Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{DynamicResource lag.notSent.header}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.notSent.1}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.notSent.2}" />
            <TextBlock Classes="item" Text="{DynamicResource lag.notSent.3}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource lag.comment.label}" />
          <TextBox Name="CommentBox" MaxLength="2000" Height="60"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="{DynamicResource lag.comment.placeholder}"
                   Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" />
        </StackPanel>

        <CheckBox Name="ConsentCheck" IsCheckedChanged="OnConsentChanged"
                  Foreground="#E2E8F0">
          <TextBlock Classes="body"
                     Text="{DynamicResource lag.consent}" />
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="{DynamicResource common.cancel}" Click="OnCancelClick"
                  Background="#334155" Foreground="#E2E8F0" />
          <Button Name="StartButton" Content="{DynamicResource lag.start}" Click="OnStartClick"
                  IsEnabled="False"
                  Background="#2563EB" Foreground="#F8FAFC" />
        </StackPanel>

      </StackPanel>

      <!-- ============================================================ running -->
      <StackPanel Name="RunningPanel" Spacing="14" IsVisible="False">
        <TextBlock Classes="body"
                   Text="{DynamicResource lag.running}" />
        <ProgressBar Name="Progress" IsIndeterminate="True" Height="4"
                     Foreground="#2563EB" Background="#1E293B" />
        <TextBlock Name="ProgressText" Classes="label" Text="{DynamicResource lag.starting}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource common.cancel}" Click="OnCancelClick"
                  Background="#334155" Foreground="#E2E8F0" />
        </StackPanel>
      </StackPanel>

      <!-- ============================================================= result -->
      <StackPanel Name="ResultPanel" Spacing="14" IsVisible="False">
        <Border Background="#1E293B" CornerRadius="8" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Name="ResultTitle" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" />
            <TextBlock Name="ResultText" Classes="body" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource common.close}" Click="OnCancelClick"
                  Background="#334155" Foreground="#E2E8F0" />
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </Grid>
</views:SurfaceWindow>
