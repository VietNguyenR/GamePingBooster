<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GamePingBooster.App.ViewModels"
        xmlns:views="using:GamePingBooster.App.Views"
        x:Class="GamePingBooster.App.Views.AccountWindow"
        x:DataType="vm:AccountViewModel"
        Title="Account"
        Width="400" SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <views:SurfaceWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#ababab" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </views:SurfaceWindow.Styles>

  <Grid RowDefinitions="Auto,Auto">

    <!--
      A spacer, not a title bar - see SurfaceWindow for why there is no title bar to draw.
      It keeps the content clear of the caption buttons and gives somewhere to drag.
    -->
    <Border Grid.Row="0" Height="34" Background="Transparent"
            PointerPressed="OnTitleBarPressed" />

  <StackPanel Grid.Row="1" Margin="24,4,24,24" Spacing="16">

    <StackPanel Spacing="2">
      <TextBlock Text="Account" Foreground="#ababab" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="label" Text="{Binding ServerText}" />
    </StackPanel>

    <TextBlock Classes="label" Text="Loading..." IsVisible="{Binding Loading}" />

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
          IsVisible="{Binding Ready}">
      <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
        <TextBlock Classes="label" Text="Signed in as" />
        <TextBlock Classes="value" Text="{Binding Email}" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
        <TextBlock Classes="label" Text="Plan" />
        <TextBlock Classes="value" Text="{Binding Plan}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
        <TextBlock Classes="label" Text="Status" />
        <TextBlock Classes="value" Text="{Binding Status}" />
      </StackPanel>

      <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Classes="label" Text="Renews / expires" />
        <TextBlock Classes="value" Text="{Binding Expires}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1">
        <TextBlock Classes="label" Text="Devices" />
        <TextBlock Classes="value" Text="{Binding Devices}" />
      </StackPanel>
    </Grid>

    <Border Background="#242424" CornerRadius="8" Padding="12" IsVisible="{Binding Ready}">
      <StackPanel Spacing="2">
        <TextBlock Classes="label" Text="This device" />
        <TextBlock Classes="value" Text="{Binding DeviceText}" FontFamily="Consolas,monospace" FontSize="11" />
      </StackPanel>
    </Border>

    <Border Background="#7F1D1D" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding Error}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" />
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Close" Click="OnCloseClick"
              Background="#111111" Foreground="#ababab" />
      <Button Content="Sign out" Click="OnSignOutClick"
              IsEnabled="{Binding Ready}"
              Background="#7F1D1D" Foreground="#FECACA" />
    </StackPanel>

    <!-- Said plainly, because it is the one thing about this button somebody might not
         expect: it also ends a connection that is running. -->
    <TextBlock Classes="label" TextWrapping="Wrap"
               Text="Signing out removes this account from this computer and disconnects if the tunnel is up. The game list already downloaded is kept - it is encrypted to this PC and useless anywhere else." />

  </StackPanel>
  </Grid>
</views:SurfaceWindow>
