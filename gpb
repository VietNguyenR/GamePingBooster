#!/bin/sh
# One entry point for this project, on any operating system.
#
# Why a POSIX shell script next to gpb.ps1 rather than one or the other:
#
# The two halves of this project do not have the same reach. The relay is Go on Linux, and anyone
# on any machine can build it, test it and deploy it. The client is Windows only - not by habit
# but by construction: it drives Wintun, netsh, a Windows service and a named pipe, none of which
# exist elsewhere. Rewriting that half in a "portable" language would produce portable-looking
# code that still refuses to run anywhere but Windows, plus a new dependency for every
# contributor. So the split is by what the command DRIVES, not by what it is written in.
#
# This script is the front door. Relay work runs natively here. Windows-only work is handed to
# gpb.ps1 when you are on Windows, and explained rather than silently failing when you are not.
#
#   ./gpb relay build            cross-compile relayd for Linux           (any OS)
#   ./gpb relay test             Go tests, vet and gofmt                  (any OS)
#   ./gpb relay list             show the relays gpb.conf declares         (any OS)
#   ./gpb relay deploy [name]    build, upload and install on a relay     (any OS)
#                                the mode comes from gpb.conf; --psk or --token asserts it
#   ./gpb relay logs [name]      follow journalctl on a relay             (any OS)
#   ./gpb relay setup            first-time setup, explained              (any OS)
#   ./gpb test                   everything: Go, plus C# if the SDK is here
#
#   ./gpb dev                    build and start the service and UI       (Windows)
#   ./gpb capture                collect game server addresses            (Windows)
#   ./gpb profile                rebuild the profile                      (Windows)
#   ./gpb check                  is the game going through the relay      (Windows)
#   ./gpb lag [seconds]          where the lag is: PC, home, ISP or relay (Windows) <~ tu dong detect xem tai sao ping lai cao, do personal network hay do relay server
#   ./gpb logs | status | stop | publish | diag                           (Windows)
#   ./gpb installer [version]    package a setup .exe                     (Windows)
#   ./gpb version [x.y.z]        show or set the product version          (Windows)
#   ./gpb reset                  strip this machine back to before install (Windows)
#
# Relays are declared in gpb.conf - host, port, user, key or password, one block each. Copy
# gpb.conf.example to gpb.conf and fill it in; it is gitignored and this repository names no
# real host. Run `./gpb relay setup` for the walkthrough.

set -eu

root=$(cd "$(dirname "$0")" && pwd)
relay="$root/relay"

say()  { printf '==> %s\n' "$*"; }
warn() { printf '    %s\n' "$*" >&2; }
die()  { printf 'gpb: %s\n' "$*" >&2; exit 1; }

need() {
    command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH. $2"
}

# --------------------------------------------------------------------------- local settings
#
# gpb.conf is PARSED, not sourced. Sourcing it would be shorter, and would also mean that a
# password containing $ or a backslash silently turned into something else, and that any command
# left in the file ran as you. Parsing takes the value literally to the end of the line, which is
# what the file's own comments promise the reader.

RELAY_DEFAULT=

load_conf() {
    conf="$root/gpb.conf"
    [ -f "$conf" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '' | '#'*) continue ;; esac
        key=${line%%=*}
        [ "$key" != "$line" ] || continue
        val=${line#*=}

        key=$(printf '%s' "$key" | tr -d ' \t')
        case "$key" in RELAY_*) ;; *) continue ;; esac
        # Anything that is not a shell name character means a malformed line, not a setting.
        # Skipping it is safer than handing it to eval below.
        [ -z "$(printf '%s' "$key" | sed 's/[A-Za-z0-9_]//g')" ] || continue

        # CRLF is likely here. gpb.conf is written by hand on Windows and is untracked, so
        # .gitattributes never sees it, and a trailing CR in a host name produces an ssh error
        # that names the wrong thing entirely. [[:space:]] covers CR.
        val=$(printf '%s' "$val" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

        # Only key paths get ~ expanded. Doing it to every value would corrupt a password that
        # happened to start with one.
        case "$key" in
            *_KEY) case "$val" in '~/'*) val="$HOME/${val#'~/'}" ;; esac ;;
        esac

        eval "$key=\$val"
    done < "$conf"
}
load_conf

# One field of one declared relay; empty when the relay or the field is not declared.
relay_field() {
    n=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]/_/g')
    eval "printf '%s' \"\${RELAY_${n}_$2:-}\""
}

relay_password() {
    pw=$(relay_field "$1" PASSWORD)
    [ -n "$pw" ] || pw=${RELAY_PASSWORD:-}
    printf '%s' "$pw"
}

# Password for sudo on the far end, which is usually the same one used to log in - a VPS with
# password authentication has one password, not two. A separate field exists for the case where
# they differ, most often key-based login plus a sudo password.
relay_sudo_password() {
    pw=$(relay_field "$1" SUDO_PASSWORD)
    [ -n "$pw" ] || pw=$(relay_password "$1")
    printf '%s' "$pw"
}

# The address a player's client connects to, which is not the SSH address: the port is relayd's
# UDP port, not the SSH port. Printed at the end of a deploy so it can be pasted into a profile.
# How many clients this relay accepts at once. Empty means 0, which relayd reads as "no cap
# beyond the address pool" - what every relay did before the setting existed, so an existing
# gpb.conf keeps working untouched.
relay_max_clients() {
    n=$(relay_field "$1" MAX)
    [ -n "$n" ] || n=0
    case "$n" in
        *[!0-9]*) die "RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_MAX is '$n'. It must be a whole number - the count of clients this relay accepts at once, or 0 for no limit." ;;
    esac
    printf '%s' "$n"
}

# Where this relay posts its status snapshot. Optional: a relay with no URL reports nothing,
# which is what a self-hosted one wants. RELAY_REPORT_URL sets it for every relay at once, and
# RELAY_<NAME>_REPORT_URL overrides it for one - the same shape as RELAY_PASSWORD.
#
# It lives in gpb.conf, which is gitignored, because it names the licence server's ingest
# endpoint and this repository is public.
relay_report_url() {
    url=$(relay_field "$1" REPORT_URL)
    [ -n "$url" ] || url=${RELAY_REPORT_URL:-}
    printf '%s' "$url"
}

# PSK remains the default so existing gpb.conf files keep working. Token relays carry the
# licence server's PUBLIC key in the deploy payload; a relay never receives the signing key.
relay_mode() {
    mode=$(relay_field "$1" MODE)
    [ -n "$mode" ] || mode=psk
    mode=$(printf '%s' "$mode" | tr '[:upper:]' '[:lower:]')
    case "$mode" in
        psk|token) ;;
        *) die "RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_MODE is '$mode'. Use psk or token." ;;
    esac
    if [ "$mode" = psk ] && [ -n "$(relay_field "$1" LICENCE_KEY)" ]; then
        die "RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_LICENCE_KEY is set, but MODE is psk. Remove it or set MODE=token."
    fi
    printf '%s' "$mode"
}

relay_licence_key() {
    key=$(relay_field "$1" LICENCE_KEY)
    [ -n "$key" ] || die "RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_MODE is token, but RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_LICENCE_KEY is empty. It must name the licence PUBLIC key file."
    case "$key" in
        '~/'*) key="$HOME/${key#'~/'}" ;;
        /*) ;;
        *) key="$root/$key" ;;
    esac
    [ -f "$key" ] && [ -r "$key" ] || die "RELAY_$(printf '%s' "$1" | tr 'a-z' 'A-Z')_LICENCE_KEY is '$key', but that file cannot be read. It must be the licence PUBLIC key, not the private key."
    printf '%s' "$key"
}

# Everything install.sh is told, as one string. Arguments rather than environment variables
# throughout: sudo resets the environment, so a variable arrives empty on the far end and the
# relay comes up misconfigured while the deploy reports success.
relay_install_args() {
    args="--max-clients $(relay_max_clients "$1")"
    case "$(relay_mode "$1")" in
        token)
            # The payload always names this licence.pub, independent of its source path on this
            # machine. That keeps a Windows path or spaces out of the remote shell command.
            relay_licence_key "$1" >/dev/null
            args="$args --licence-key ../licence.pub"
            ;;
        psk)
            # Said out loud, not left implicit, and this is the line that decides whether a
            # relay can be moved back off token mode at all.
            #
            # install.sh keeps a relay that already has /etc/gpb/licence.pub in TOKEN mode when
            # no mode is named. That rule exists for a deploy typed by hand, which does not know
            # licensed mode exists - see the comment above KEEP_LICENCE there. This deploy is not
            # that: it read the mode out of gpb.conf, so it has to state it. Sending nothing let
            # the state of the far end decide instead, and a relay declared psk that happened to
            # be running as token silently stayed token, unit and all.
            args="$args --psk"
            ;;
    esac
    url=$(relay_report_url "$1")
    [ -z "$url" ] || args="$args --report-url $url"
    printf '%s' "$args"
}

relay_endpoint() {
    host=$(relay_field "$1" HOST)
    [ -n "$host" ] || return 0
    listen=$(relay_field "$1" LISTEN)
    [ -n "$listen" ] || listen=51820
    printf '%s:%s' "$host" "$listen"
}

relay_names() {
    # `set` with no arguments prints every variable as name=value. Bash also prints function
    # bodies, which this pattern simply does not match.
    set | sed -n 's/^RELAY_\([A-Za-z0-9_]*\)_HOST=.*/\1/p' | tr 'A-Z' 'a-z' | sort -u
}

# Run ssh against a relay, whether gpb.conf declares it or it is a bare alias.
#
# The arguments are built with `set --` rather than joined into a string, so a key path with a
# space in it - normal on Windows - stays one argument.
#
# Set ssh_tty_flag to -t around a call that needs a terminal on the far end, which sudo does when
# it has to prompt for a password itself. Never set it for the call that carries the tarball: a
# pty translates newlines and would corrupt the gzip stream.
ssh_tty_flag=
relay_ssh() {
    name=$1
    shift
    host=$(relay_field "$name" HOST)
    if [ -z "$host" ]; then
        # Not declared here, so it is an alias from ~/.ssh/config or a plain user@host. Hand it
        # to ssh unchanged and let ssh's own configuration answer for it.
        set -- "$name" "$@"
        [ -z "$ssh_tty_flag" ] || set -- "$ssh_tty_flag" "$@"
        ssh "$@"
        return
    fi
    user=$(relay_field "$name" USER)
    [ -n "$user" ] || user=root
    port=$(relay_field "$name" PORT)
    [ -n "$port" ] || port=22
    key=$(relay_field "$name" KEY)

    set -- "$user@$host" "$@"
    # IdentitiesOnly stops ssh offering every key the agent holds before the one that was named,
    # which on a host with MaxAuthTries 3 and four keys loaded fails before it ever gets there.
    [ -z "$key" ] || set -- -i "$key" -o IdentitiesOnly=yes "$@"
    set -- -p "$port" "$@"
    [ -z "$ssh_tty_flag" ] || set -- "$ssh_tty_flag" "$@"
    ssh "$@"
}

# ------------------------------------------------------------------- what runs on the far end
#
# Three remote scripts, because a deploy has to cope with three kinds of account.
#
# The staging directory is under $HOME rather than /opt, because an unprivileged account cannot
# create /opt/gpb - that is the "mkdir: Permission denied" a non-root deploy used to die on.
# Nothing is installed from there: install.sh finds its own directory and copies to absolute
# paths, so where it is unpacked does not matter.
#
# Exit 90 means "not root, and sudo wants a password". It cannot be handled on this connection:
# stdin is the tarball, and sudo -S reads its password from stdin. The caller opens a second
# connection, where stdin is free. Exit 91 means there is no sudo at all.
#
# These strings are duplicated in relay\deploy.ps1 - keep the two in step. They contain no double
# quotes on purpose: the PowerShell copy has to travel through cmd, inside a double-quoted
# argument, and a quote of its own would end that argument early. ~ is used rather than "$HOME"
# for the same reason - the login shell expands it and it needs no quoting.
#
# The sudo check is written the long way round, with an empty then-branch, rather than as
# `if ! command -v sudo`. A '!' is one delayed-expansion setting away from being eaten somewhere
# on the trip through cmd, and losing it would invert the test: every host that HAS sudo would
# be told it has none. The long form cannot fail that way.
# Functions rather than constants, because the client cap comes from gpb.conf and is therefore
# per relay. It reaches install.sh as an ARGUMENT, never as an environment variable: sudo resets
# the environment, so a variable would arrive empty and the relay would come up with no cap at
# all while the deploy reported success.
remote_stage() {
    printf '%s' "set -e
    mkdir -p ~/.gpb-deploy
    tar -xzf - -C ~/.gpb-deploy
    cd ~/.gpb-deploy/deploy
    sed -i 's/\r\$//' *.sh
    chmod +x *.sh
    if [ \$(id -u) -eq 0 ]; then ./install.sh $1; exit; fi
    if command -v sudo >/dev/null 2>&1; then :; else exit 91; fi
    if sudo -n true 2>/dev/null; then sudo -n ./install.sh $1; exit; fi
    exit 90"
}

# -p '' suppresses sudo's own prompt, which would otherwise appear in the output as a stray
# 'Password:' with nothing typed after it.
remote_install_stdin() {
    printf '%s' "cd ~/.gpb-deploy/deploy && sudo -S -p '' ./install.sh $1"
}
remote_install_tty() {
    printf '%s' "cd ~/.gpb-deploy/deploy && sudo ./install.sh $1"
}

# Reached only when the tarball is already unpacked on the far end and all that is left is to run
# install.sh as root.
relay_install_with_sudo() {
    name=$1
    args=$(relay_install_args "$name")
    pw=$(relay_sudo_password "$name")
    if [ -n "$pw" ]; then
        say "sudo needs a password on $name; using the one from gpb.conf"
        printf '%s\n' "$pw" | relay_ssh "$name" "$(remote_install_stdin "$args")" || die \
            "the install step failed. If sudo rejected the password, set RELAY_<NAME>_SUDO_PASSWORD in gpb.conf."
    else
        say "sudo needs a password on $name. Type it when it asks."
        ssh_tty_flag=-t
        relay_ssh "$name" "$(remote_install_tty "$args")" || {
            ssh_tty_flag=
            die "the install step failed - see the output above"
        }
        ssh_tty_flag=
    fi
}

# OpenSSH will not take a password from a flag, a file or an environment variable - that is
# deliberate on its part. The one supported way to supply one without a human at the keyboard is
# SSH_ASKPASS: ssh runs the named program and reads the password from its output. So the helper
# below is written at call time, reads the password from the environment rather than containing
# it, and is deleted on the way out however the script ends.
askpass_file=
arm_askpass() {
    [ -n "$1" ] || return 0
    askpass_file=$(mktemp)
    cat > "$askpass_file" <<'ASKPASS'
#!/bin/sh
printf '%s\n' "$GPB_SSH_PASSWORD"
ASKPASS
    chmod 700 "$askpass_file"
    trap 'rm -f "$askpass_file"' EXIT INT TERM HUP
    GPB_SSH_PASSWORD=$1
    export GPB_SSH_PASSWORD
    SSH_ASKPASS=$askpass_file
    export SSH_ASKPASS
    # Without force, ssh only asks the helper when there is no terminal, and falls back to
    # prompting the moment one exists - which is exactly when you run this by hand.
    SSH_ASKPASS_REQUIRE=force
    export SSH_ASKPASS_REQUIRE
}

# Resolve the relay a command should act on, and explain the options when there is no answer.
#
# It sets $picked rather than printing the name, because printing would mean calling it as
# $(pick_relay ...) - and the exit below would then end only the command substitution's subshell,
# leaving the caller to carry on with an empty relay name.
picked=
pick_relay() {
    picked=${1:-$RELAY_DEFAULT}
    [ -z "$picked" ] || return 0

    warn "Which relay? Name one, or set RELAY_DEFAULT in gpb.conf."
    names=$(relay_names)
    if [ -n "$names" ]; then
        warn ""
        warn "Declared in gpb.conf:"
        printf '        %s\n' $names >&2
    else
        warn ""
        warn "gpb.conf declares none yet. Run ./gpb relay setup."
    fi
    exit 1
}

is_windows=0
case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW* | MSYS* | CYGWIN* | Windows_NT) is_windows=1 ;;
esac

# Hand a verb to the PowerShell side. Everything routed here touches a Windows service, the
# routing table, a named pipe or Npcap, so there is nothing to fall back to on another system.
delegate() {
    verb=$1
    shift
    if [ "$is_windows" -eq 0 ]; then
        warn "'$verb' drives Windows components - a virtual adapter, the routing table, a Windows"
        warn "service - and has no meaning on $(uname -s). The relay verbs all work here:"
        warn ""
        warn "    ./gpb relay build | test | list | deploy [name] | logs [name]"
        exit 2
    fi
    need powershell "It ships with Windows; make sure C:/Windows/System32/WindowsPowerShell/v1.0 is on PATH."
    exec powershell -NoProfile -ExecutionPolicy Bypass -File "$root/gpb.ps1" "$verb" "$@"
}

# The version from the VERSION file is stamped into the binary. It is only ever displayed - in
# the startup log line and in the status report the dashboard shows - but without it every relay
# reports itself as "dev" and there is no way to tell which box is still running an old build.
relay_version() {
    if [ -f "$root/VERSION" ]; then tr -d ' 	
' < "$root/VERSION"; else printf 'dev'; fi
}

relay_build() {
    need go "Install Go 1.22 or newer from https://go.dev/dl/"
    say "Cross-compiling relayd for Linux"
    ( cd "$relay" && CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=$(relay_version)" -o relayd ./cmd/relayd )
    say "Built $relay/relayd"
}

relay_test() {
    need go "Install Go 1.22 or newer from https://go.dev/dl/"
    say "gofmt"
    unformatted=$( cd "$relay" && gofmt -l . )
    if [ -n "$unformatted" ]; then
        die "gofmt would change these files:
$unformatted"
    fi
    say "go vet"
    ( cd "$relay" && go vet ./... )
    # Go's test cache does not notice that testdata/protocol-vectors.json changed: it is
    # outside the package directory, so it is not one of the inputs the cache is keyed on.
    # Measured, not assumed - a tampered vector file was reported as a cached pass while the
    # same run with -count=1 failed. Since the whole point of that file is to catch drift
    # between the Go and C# implementations, a cached pass is the exact failure it exists to
    # prevent. The full suite takes about six seconds cold, so always re-running is cheap.
    say "go test"
    ( cd "$relay" && go test -count=1 ./... )
}

relay_list() {
    names=$(relay_names)
    if [ -z "$names" ]; then
        warn "gpb.conf declares no relays. Copy gpb.conf.example to gpb.conf and fill in one block."
        return 0
    fi
    printf '%-10s %-24s %-22s %-12s %-8s %-12s %s\n' NAME 'SSH' 'CLIENT ENDPOINT' 'AUTH' MODE 'MAX CLIENTS' 'REPORTS TO'
    for n in $names; do
        user=$(relay_field "$n" USER); [ -n "$user" ] || user=root
        port=$(relay_field "$n" PORT); [ -n "$port" ] || port=22
        if [ -n "$(relay_field "$n" KEY)" ]; then
            auth=key
        elif [ -n "$(relay_password "$n")" ]; then
            auth=password
        else
            auth='ssh decides'
        fi
        # An `x && y` list that fails IS fatal under set -e when it stands on its own, so this
        # stays an if. That mistake would only show up for a relay that is not the default.
        mark=' '
        if [ "$n" = "$RELAY_DEFAULT" ]; then mark='*'; fi
        # Shown because this table is how you check what actually got parsed, and a cap that
        # silently read as 0 looks exactly like a relay with no cap configured.
        max=$(relay_max_clients "$n")
        if [ "$max" -eq 0 ]; then max='no limit'; fi
        # A relay that reports nowhere is invisible in the dashboard, which looks exactly like
        # a relay that has died. Worth seeing here, where it is one line to fix.
        reports=$(relay_report_url "$n"); [ -n "$reports" ] || reports='-'
        mode=$(relay_mode "$n")
        printf '%-10s %-24s %-22s %-12s %-8s %-12s %s\n' \
            "$n$mark" "$user@$(relay_field "$n" HOST):$port" "$(relay_endpoint "$n")" "$auth" "$mode" "$max" "$reports"
    done
    printf '\n* = RELAY_DEFAULT, used when a command is given no name.\n'
}

relay_setup() {
    cat <<'EOF'

Setting up a relay, start to finish.

1. Declare it in gpb.conf. Copy the example and edit one block - host, and whichever of user,
   port, key or password your VPS needs. The name in the middle of the key is yours to pick and
   is what you type on the command line:

    cp gpb.conf.example gpb.conf

    RELAY_SG_HOST=203.0.113.10
    RELAY_SG_USER=root
    RELAY_SG_KEY=~/.ssh/id_ed25519
    RELAY_DEFAULT=sg

   gpb.conf is gitignored. Check what got read:

    ./gpb relay list

2. If you have no key yet, make one and install it. Once per host, and the last time you type
   that password:

    ssh-keygen -t ed25519
    ssh-copy-id -i ~/.ssh/id_ed25519.pub root@203.0.113.10

   ssh-copy-id is missing from Git for Windows. Without it:

    cat ~/.ssh/id_ed25519.pub | ssh root@203.0.113.10 \
      "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"

   A password in RELAY_<NAME>_PASSWORD works instead, and costs one prompt-free deploy, but it
   sits in plain text on your disk. gpb.conf.example says more about that trade.

3. Deploy. This builds relayd, ships it in one connection and runs install.sh on the far end:

    ./gpb relay deploy sg          (or just ./gpb relay deploy, for RELAY_DEFAULT)
    ./gpb relay logs sg

   An account that is not root needs sudo for the install step, which the deploy works out on
   the far end. If sudo wants a password it uses RELAY_<NAME>_SUDO_PASSWORD, or the login
   password when that is empty, and asks you on the terminal if there is neither.

4. install.sh prints the endpoint and the PSK. They go into two different files, because they
   are two different things:

    endpoint <ip>:51820  ->  profiles/<profile>.json, as an entry in "relays"
    PSK                  ->  client/config.json, as "psk"

   Neither belongs in gpb.conf: that file is only about reaching the VPS.

EOF
}

# Deploy without PowerShell, so a contributor on Linux is not locked out of the one half of the
# project they can actually run. Same steps deploy.ps1 takes, in the same order.
relay_deploy() {
    # A mode flag typed here is CHECKED against gpb.conf, never quietly ignored.
    #
    # `./gpb relay deploy hk --psk` used to be swallowed whole - the flag reached nothing, and
    # the deploy went out in whatever mode the far end already had. Where the flag agrees with
    # the declaration it is a no-op, which is what makes it safe to type; where it disagrees the
    # deploy stops, because the mode belongs to one place. gpb.conf is where the licence key, the
    # client cap and the report URL for this relay are declared, and a deploy that contradicted
    # it would be undone by the next one that did not.
    want_mode=
    name=
    while [ $# -gt 0 ]; do
        case "$1" in
            --psk)   want_mode=psk ;;
            --token) want_mode=token ;;
            -*)      die "unknown option '$1'. Usage: ./gpb relay deploy [name] [--psk|--token]" ;;
            *)
                [ -z "$name" ] || die "name the relay once: ./gpb relay deploy [name] [--psk|--token]"
                name=$1
                ;;
        esac
        shift
    done

    pick_relay "$name"
    target=$picked

    # Before the build, not after: a mode that does not match should cost a second, not a
    # cross-compile.
    mode=$(relay_mode "$target")
    if [ -n "$want_mode" ] && [ "$want_mode" != "$mode" ]; then
        slug=$(printf '%s' "$target" | tr 'a-z' 'A-Z')
        die "--$want_mode was asked for, but RELAY_${slug}_MODE says $mode.
    The mode is declared in gpb.conf, so that this deploy and the next one agree.
    Set RELAY_${slug}_MODE=$want_mode there (a token relay also needs RELAY_${slug}_LICENCE_KEY) and run this again."
    fi

    need ssh "Install OpenSSH."
    need tar "Install tar. Windows 10 and later ship it in System32."

    arm_askpass "$(relay_password "$target")"

    relay_build

    # The payload goes over ONE ssh connection, as a tar stream on stdin.
    #
    # The obvious version - ssh mkdir, scp the binary, scp the scripts, ssh install - opens four
    # connections, and with password authentication that is four password prompts for one deploy.
    # Key authentication hides the cost, which is why it went unnoticed. Piping a tar means one
    # connection and therefore exactly one prompt, whichever authentication the server uses.
    #
    # An account that needs a sudo password costs a second connection, and only that case: see
    # REMOTE_STAGE for why it cannot be done on this one.
    #
    # The sed on the far end strips CR: these files are edited on Windows, and a shell script with
    # CRLF endings fails on Linux with an error that names the wrong thing entirely.
    # .gitattributes should keep them LF now, so it is a second line of defence rather than the
    # thing making it work.
    max=$(relay_max_clients "$target")
    if [ "$max" -gt 0 ]; then
        cap="max $max clients"
    else
        cap="no client limit"
    fi
    if [ "$mode" = token ]; then
        label="token mode"
    else
        label="PSK mode"
    fi
    if [ -n "$(relay_password "$target")" ]; then
        say "Deploying to $target ($label, $cap, one connection, password from gpb.conf)"
    else
        say "Deploying to $target ($label, $cap, one connection - expect at most one password prompt)"
    fi

    # || rc=$? rather than a bare call: under set -e a non-zero exit would end the script here,
    # and 90 is not a failure, it is the far end asking for a second connection.
    rc=0
    licence_stage=
    if [ "$mode" = token ]; then
        licence_stage=$(mktemp -d)
        cp "$(relay_licence_key "$target")" "$licence_stage/licence.pub"
        tar -czf - -C "$relay" relayd deploy/setup-nat.sh deploy/install.sh deploy/relayd.service -C "$licence_stage" licence.pub |
            relay_ssh "$target" "$(remote_stage "$(relay_install_args "$target")")" || rc=$?
        rm -rf "$licence_stage"
    else
        tar -czf - -C "$relay" relayd deploy/setup-nat.sh deploy/install.sh deploy/relayd.service |
        relay_ssh "$target" "$(remote_stage "$(relay_install_args "$target")")" || rc=$?
    fi

    case "$rc" in
        0) ;;
        90) relay_install_with_sudo "$target" ;;
        91) die "the account on $target is not root and has no sudo. Deploy as root, or install sudo there." ;;
        *)  die "deploy failed - see the output above" ;;
    esac

    endpoint=$(relay_endpoint "$target")
    say "Done. Follow it with:  ./gpb relay logs $target"
    if [ -n "$endpoint" ]; then
        printf '\n    The endpoint above goes into a profile, not into gpb.conf:\n\n'
        printf '      "relays": [ { "id": "%s", "name": "%s", "endpoint": "%s" } ]\n\n' \
            "$target" "$target" "$endpoint"
        if [ "$mode" = token ]; then
            printf '    This relay uses licence tokens; the profile entry also needs its relay public key.\n\n'
        else
            printf '    The PSK goes into client/config.json, with "defaultRelayId": "%s".\n\n' "$target"
        fi
    fi
}

usage() {
    # Everything from line 2 until the comment block ends. This used to be `sed -n '2,33p'`,
    # which silently swallowed the last line of the help the moment a command was added above.
    awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
}

[ $# -gt 0 ] || { usage; exit 0; }

verb=$1
shift

case "$verb" in
    relay)
        sub=${1:-}
        [ $# -gt 0 ] && shift
        case "$sub" in
            build)  relay_build ;;
            test)   relay_test ;;
            list)   relay_list ;;
            deploy) relay_deploy "$@" ;;
            logs)
                pick_relay "${1:-}"
                host=$picked
                need ssh "Install OpenSSH."
                arm_askpass "$(relay_password "$host")"
                relay_ssh "$host" 'journalctl -u relayd -f'
                ;;
            setup)  relay_setup ;;
            *)
                printf '  relay build            cross-compile relayd for Linux\n'
                printf '  relay test             gofmt, go vet, go test\n'
                printf '  relay list             show the relays gpb.conf declares\n'
                printf '  relay deploy [name]    build, upload and install; the mode comes from\n'
                printf '                         gpb.conf, and --psk or --token asserts it\n'
                printf '  relay logs [name]      follow journalctl\n'
                printf '  relay setup            first-time setup, explained\n'
                ;;
        esac
        ;;

    test)
        relay_test
        # The deploy tooling has no compiler to catch it: the mode a relay is installed in comes
        # out of a string built in two places, and getting it wrong takes a fleet offline quietly.
        if command -v bash >/dev/null 2>&1; then
            say "relay deploy: the declared mode is the mode installed"
            bash "$root/tools/test-relay-deploy-mode.sh"
        else
            warn "bash not found - skipped tools/test-relay-deploy-mode.sh"
        fi
        # The C# half needs the .NET SDK. On a machine without it the Go tests are still worth
        # running on their own rather than failing the whole command.
        if command -v dotnet >/dev/null 2>&1; then
            say "C#: build and wire-format check"
            dotnet build "$root/client/GamePingBooster.sln" --nologo -v quiet
            dotnet run --project "$root/client/src/GamePingBooster.ProtocolCheck/GamePingBooster.ProtocolCheck.csproj"
        else
            warn "dotnet not found - skipped the C# build and the wire-format check."
            warn "The Go side passed; install the .NET 9 SDK to check the client too."
        fi
        say "Done"
        ;;

    dev | capture | profile | check | lag | logs | status | stop | publish | diag | installer | reset | version)
        delegate "$verb" "$@"
        ;;

    help | -h | --help) usage ;;

    *) die "unknown command '$verb'. Run ./gpb help" ;;
esac
