<Project Sdk="Microsoft.NET.Sdk">

  <!-- The stand-in game for the multi-tunnel rig: its process name is what the rig profile watches for. Not part of
       the solution and never shipped. See tools/multi-tunnel-rig/rig.sh and TunnelCheck's "service" mode. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RigGame</AssemblyName>
  </PropertyGroup>

</Project>
